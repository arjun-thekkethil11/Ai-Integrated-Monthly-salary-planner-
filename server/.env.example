# Copy to .env. Optional — the app fully works without this (rule-based
# categorization/insights/planner still run). Adding a key unlocks:
#   - Natural-language "quick add" for expenses
#   - AI-generated savings insights alongside the rule-based ones
#   - A plain-language explanation of Purchase Planner results
#     (the yes/no itself still comes from your saved salary, balance, and spending)
#
# Default here: Gemini via its OpenAI-compatible endpoint (https://aistudio.google.com/apikey).
# To use OpenAI instead:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.8-flash

# --- Free-tier guardrail -----------------------------------------------
# Soft usage caps enforced server-side so a busy day of tapping around
# can't burn through a free-tier quota. Text & photo-scan calls share ONE
# daily budget below (most providers, incl. Gemini's free tier, cap
# requests/day per model regardless of call type) — a photo scan costs
# AI_IMAGE_REQUEST_WEIGHT "units" of that budget since it's far more
# token-hungry than a short text prompt. Daily counts persist in the local
# DB across restarts; per-minute bursts are checked in-memory only.
AI_MAX_REQUESTS_PER_DAY=15
AI_IMAGE_REQUEST_WEIGHT=2
AI_MAX_TEXT_PER_MINUTE=4
AI_MAX_IMAGE_PER_MINUTE=1
